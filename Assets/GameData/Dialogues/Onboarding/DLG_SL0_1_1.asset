MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a47ae6b2fbf34564bb18344c47c22eea, type: 3}
  m_Name: DLG_SL0_1_1
  m_EditorClassIdentifier: 
  lines:
  - text: As you can see on your <color=#76fd45><b>right</b></color>, you now have
      <b><color=#df7956>3 <sprite=0>  BRONZE</color></b> fragments!
    npcImage: {fileID: 21300000, guid: 8726e1acf043ab7458c657ccfd002abf, type: 3}
    buttonText: So shiny!
    highlightID: 1
    npcSFX: {fileID: 8300000, guid: d82c7893165324c46b9a9d627f9dba00, type: 3}
    jomaSFX: {fileID: 8300000, guid: a310acfbd5b447b46949283447c83bc5, type: 3}
  - text: But this world is filled with more than <b>7 different</b> resources, and
      they each have a use.
    npcImage: {fileID: 21300000, guid: a45fb2ba6b66d0248841039a01baca32, type: 3}
    buttonText: Like?
    highlightID: 1
    npcSFX: {fileID: 8300000, guid: eab291c8a1f9984448aa94257e3de508, type: 3}
    jomaSFX: {fileID: 8300000, guid: ff76c54bea289466fad5abfb68468520, type: 3}
  - text: Some open <sprite=2> <b>CHESTS</b>, others craft <sprite=9> <b>HELMETS</b>...
      you can even trade them for <sprite=12> <b>COINS</b>.
    npcImage: {fileID: 21300000, guid: aef12474eae64534fbef8c36a460a916, type: 3}
    buttonText: Interesting...
    highlightID: 0
    npcSFX: {fileID: 8300000, guid: 38d73f45af347ee45bf759933e3d4966, type: 3}
    jomaSFX: {fileID: 8300000, guid: eca1355730476b6498f5c55edf9ba20c, type: 3}
  - text: Complete the floor objective shown on your <color=#76fd45><b>bottom right
      </b></color>and I will spill some more secrets.
    npcImage: {fileID: 21300000, guid: a45fb2ba6b66d0248841039a01baca32, type: 3}
    buttonText: Easy!
    highlightID: 3
    npcSFX: {fileID: 8300000, guid: d82c7893165324c46b9a9d627f9dba00, type: 3}
    jomaSFX: {fileID: 8300000, guid: f0a00122d1bc44608aabe6f939b2ecf8, type: 3}
