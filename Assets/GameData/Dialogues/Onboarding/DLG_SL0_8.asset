MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a47ae6b2fbf34564bb18344c47c22eea, type: 3}
  m_Name: DLG_SL0_8
  m_EditorClassIdentifier: 
  lines:
  - text: <b><size=120%>You are ready Joma!</size></b> Head down to our <b>Dwarf
      Hold</b> using either the hole on the floor or the <color=#b165f1><b><sprite=4>
      Blaster</b></color>.
    npcImage: {fileID: 21300000, guid: 8726e1acf043ab7458c657ccfd002abf, type: 3}
    buttonText: Is that a CANNON?
    highlightID: 0
  - text: Each <b>checkpoint</b> floor will have one. Checkpoints are safe floors
      where you <b>respawn back</b> if you break all your helmets and faint.
    npcImage: {fileID: 21300000, guid: a45fb2ba6b66d0248841039a01baca32, type: 3}
    buttonText: Hollow Knight Style!
    highlightID: 0
  - text: So <color=#b165f1><b><sprite=4> Blasters</b></color> let you skip floors
      you already cleared and start straight in a specific checkpoint.
    npcImage: {fileID: 21300000, guid: aef12474eae64534fbef8c36a460a916, type: 3}
    buttonText: Awesome!
    highlightID: 0
  - text: "No more budget, no more tips! From now on, the journey itself will teach
      you - mysteries, dangers\u2026 <size=120%><b>just use your head.</b></size>"
    npcImage: {fileID: 21300000, guid: aef12474eae64534fbef8c36a460a916, type: 3}
    buttonText: To the Dwarf Den!
    highlightID: 0
