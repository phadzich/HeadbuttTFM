  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a47ae6b2fbf34564bb18344c47c22eea, type: 3}
  m_Name: DLG_SL0_5
  m_EditorClassIdentifier: 
  lines:
  - text: "That Miguel\u2026 still doesn\u2019t know what a Quaternion is. Where
      were we?"
    npcImage: {fileID: 21300000, guid: 8726e1acf043ab7458c657ccfd002abf, type: 3}
    buttonText: The tutorial...
    highlightID: 0
    npcSFX: {fileID: 8300000, guid: 77acd59186fdd4442802d00aaf954008, type: 3}
    jomaSFX: {fileID: 8300000, guid: 662abafc7dfe3c147a2ab33b58a38afb, type: 3}
  - text: "Right! That shiny helmet there is a <color=#65FF9C><b>Blueprint</b></color>.
      Find them on your journey and you\u2019ll craft<size=120%> LEGENDARY </size>helmets."
    npcImage: {fileID: 21300000, guid: a45fb2ba6b66d0248841039a01baca32, type: 3}
    buttonText: "But it\u2019s blocked\u2026"
    highlightID: 0
    npcSFX: {fileID: 8300000, guid: 38d73f45af347ee45bf759933e3d4966, type: 3}
    jomaSFX: {fileID: 8300000, guid: ff76c54bea289466fad5abfb68468520, type: 3}
  - text: "Of course, that <sprite=23><b>gate</b> won\u2019t let you grab it. Find
      an <color=#ff9c28><b>orange</b></color> button block, that\u2019s a <sprite=3><b>switch</b>.
      <color=#65FF9C><b>Headbutt</b></color> it and the gate opens!"
    npcImage: {fileID: 21300000, guid: aef12474eae64534fbef8c36a460a916, type: 3}
    buttonText: Let's go!
    highlightID: 0
    npcSFX: {fileID: 8300000, guid: eab291c8a1f9984448aa94257e3de508, type: 3}
    jomaSFX: {fileID: 8300000, guid: f0a00122d1bc44608aabe6f939b2ecf8, type: 3}
