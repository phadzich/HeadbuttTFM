%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a47ae6b2fbf34564bb18344c47c22eea, type: 3}
  m_Name: DLG_SL0_6
  m_EditorClassIdentifier: 
  lines:
  - text: "Remember those beautiful <color=#e64550><b>red</b></color> resources you
      just mined? Not just decoration! They\u2019re for <sprite=11><b> crafting</b>
      that blueprint."
    npcImage: {fileID: 21300000, guid: 8726e1acf043ab7458c657ccfd002abf, type: 3}
    buttonText: How though?
    highlightID: 0
    npcSFX: {fileID: 8300000, guid: 77acd59186fdd4442802d00aaf954008, type: 3}
    jomaSFX: {fileID: 8300000, guid: ff76c54bea289466fad5abfb68468520, type: 3}
  - text: See that <b>anvil and hammer</b>? Thats a<sprite=11><b> Forger</b>. Step
      up and make your first helmet.
    npcImage: {fileID: 21300000, guid: a45fb2ba6b66d0248841039a01baca32, type: 3}
    buttonText: Awesome!
    highlightID: 0
    npcSFX: {fileID: 8300000, guid: 0acb53c3023e61e4fa590489c202df11, type: 3}
    jomaSFX: {fileID: 8300000, guid: eca1355730476b6498f5c55edf9ba20c, type: 3}
  - text: 'Each <sprite=9><b> helmet</b> has its own stats: <sprite=16><b> health</b>,
      <sprite=15><b> damage</b>, even <sprite=5> <b> elemental</b> powers and shields!'
    npcImage: {fileID: 21300000, guid: aef12474eae64534fbef8c36a460a916, type: 3}
    buttonText: Amazing!
    highlightID: 0
    npcSFX: {fileID: 8300000, guid: d82c7893165324c46b9a9d627f9dba00, type: 3}
    jomaSFX: {fileID: 8300000, guid: a310acfbd5b447b46949283447c83bc5, type: 3}
  - text: "On your way you\u2019ll find more minerals, more helmets. <size=120%><b>Collect
      smart</b></size>, your survival depends on it."
    npcImage: {fileID: 21300000, guid: a45fb2ba6b66d0248841039a01baca32, type: 3}
    buttonText: Not afraid!
    highlightID: 0
    npcSFX: {fileID: 8300000, guid: eab291c8a1f9984448aa94257e3de508, type: 3}
    jomaSFX: {fileID: 8300000, guid: f0a00122d1bc44608aabe6f939b2ecf8, type: 3}
